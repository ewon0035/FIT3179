{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "GNI Per Capita of the World",
  "width": 1000,
  "height": 600,
  "projection": {"type": "mercator"},
  "data": {
    "url": "js/ne_110m_admin_0_countries.topojson",
    "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
  },
  "transform": [
    {
      "filter": "datum.properties.NAME !== 'Antarctica'"
    },
    {
      "lookup": "properties.NAME",
      "from": {
        "data": {"url": "data/data.csv"},
        "key": "Country Name",
        "fields": ["2024"]
      }
    },
    {
      "calculate": "isValid(datum['2024']) ? datum['2024'] : 0",
      "as": "GNI Per Capita"
    }
  ],
  "mark": {"type": "geoshape", "stroke": "white", "strokeWidth": 0.5},
  "encoding": {
    "color": {
      "condition": {
        "test": "datum['GNI Per Capita'] > 0",
        "field": "GNI Per Capita",
        "type": "quantitative",
        "scale": {"type": "linear", "domainMin": 1, "scheme": "blues"},
        "title": "GNI Per Capita (USD)"
      },
      "value": "lightgray"
    },
    "tooltip": [
      {"field": "properties.NAME", "type": "nominal", "title": "Country"},
      {
        "field": "GNI Per Capita",
        "type": "quantitative",
        "title": "GNI Per Capita (USD)",
        "format": ","
      }
    ]
  },
  "config": {
    "background": null,
    "title": {"fontSize": 18, "fontWeight": "bold"}
  }
}
