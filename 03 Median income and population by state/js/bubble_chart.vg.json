{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 1150,
  "height": 600,
  "title": "Median Income by Statistical Area Level 4 (2021-2022)",
  "config": {"background": "transparent"},
  "data": {
    "url": "https://raw.githubusercontent.com/ewon0035/FIT3179/refs/heads/data_visualisation_ii/03%20Median%20income%20and%20population%20by%20state/data/data.csv"
  },
  "params": [
    {
      "name": "Min_Earners",
      "value": 0,
      "bind": {
        "input": "range",
        "min": 0,
        "max": 500000,
        "step": 10000,
        "name": "Minimum Earners: "
      }
    },
    {
      "name": "State_selection",
      "bind": {
        "input": "select",
        "options": [
          null,
          "Australian Capital Territory",
          "New South Wales",
          "Northern Territory",
          "Queensland",
          "South Australia",
          "Tasmania",
          "Victoria",
          "Western Australia"
        ],
        "labels": [
          "Show All",
          "Australian Capital Territory",
          "New South Wales",
          "Northern Territory",
          "Queensland",
          "South Australia",
          "Tasmania",
          "Victoria",
          "Western Australia"
        ],
        "name": "State/Territory: "
      }
    }
  ],
  "transform": [
    {"filter": "datum.Earners > Min_Earners"},
    {"filter": "datum['Earners'] > 0 && datum['Total Income'] > 0"},
    {"filter": "State_selection == null || datum['State/territory'] == State_selection"}
  ],
  "encoding": {
    "x": {
      "field": "Earners",
      "type": "quantitative",
      "title": "Number of Earners",
      "axis": {"tickCount": 7, "grid": false},
      "scale": {"type": "log"}
    },
    "y": {
      "field": "Total Income",
      "type": "quantitative",
      "title": "Total Income (AUD)",
      "axis": {"tickCount": 6, "grid": false},
      "scale": {"type": "log"}
    }
  },
  "layer": [
    {
      "mark": "circle",
      "encoding": {
        "size": {
          "field": "Median Income",
          "type": "quantitative",
          "scale": {"type": "sqrt", "range": [50, 500]},
          "legend": {"title": "Median Income"}
        },
        "color": {
          "field": "State/territory",
          "type": "nominal",
          "legend": {"title": "State/Territory"}
        },
        "opacity": {"value": 0.6},
        "tooltip": [
          {"field": "Area", "type": "nominal"},
          {"field": "State/territory", "type": "nominal"},
          {"field": "Median Income", "type": "quantitative", "format": ","},
          {"field": "Earners", "type": "quantitative", "format": ","},
          {"field": "Total Income", "type": "quantitative", "format": ","}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -12,
        "fontSize": 11,
        "fontStyle": "italic"
      },
      "encoding": {
        "text": {"field": "Area", "type": "nominal"},
        "color": {"value": "black"},
        "opacity": {
          "condition": {
            "test": "indexof(['Darwin', 'Sydney - City and Inner South', 'Melbourne - Inner', 'Brisbane - Inner City', 'Perth - Inner', 'Australian Capital Territory', 'Northern Territory - Outback', 'Queensland - Outback', 'Melbourne - South East'], datum['Area']) >= 0",
            "value": 1
          },
          "value": 0
        },
        "tooltip": [
          {"field": "Area", "type": "nominal"},
          {"field": "State/territory", "type": "nominal"},
          {"field": "Median Income", "type": "quantitative", "format": ","},
          {"field": "Earners", "type": "quantitative", "format": ","},
          {"field": "Total Income", "type": "quantitative", "format": ","}
        ]
      }
    }
  ]
}
