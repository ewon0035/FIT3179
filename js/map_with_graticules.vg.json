{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 900,
  "height": 800,
  "title": "Population of Australia by State/Territory (March 2025)",
  "projection": {"type": "mercator", "center": [133, -28], "scale": 1000},
  "layer": [
    {
      "data": {
        "url": "js/australia.topojson",
        "format": {"type": "topojson", "feature": "ne_110m_graticules_5"}
      },
      "mark": {"type": "geoshape", "stroke": "lightgray", "fill": null}
    },
    {
      "data": {
        "url": "js/australia.topojson",
        "format": {"type": "topojson", "feature": "STE_2021_AUST_GDA2020"}
      },
      "transform": [
        {
          "lookup": "properties.STE_NAME21",
          "from": {
            "data": {"url": "data/population.csv"},
            "key": "State",
            "fields": ["Population"]
          }
        },
        {
          "calculate": "datum.Population / datum.properties.AREASQKM21",
          "as": "pop_density"
        },
        {
          "calculate": "log(datum.pop_density + 1) / log(10)",
          "as": "pop_density_log10"
        }
      ],
      "mark": {"type": "geoshape", "stroke": "white", "strokeWidth": 0.6},
      "encoding": {
        "color": {
          "field": "pop_density_log10",
          "type": "quantitative",
          "title": "Population per km² (log10)",
          "scale": {"scheme": "blues"}
        },
        "tooltip": [
          {"field": "properties.STE_NAME21", "title": "State/Territory"},
          {"field": "Population", "type": "quantitative", "title": "Population", "format": ","},
          {"field": "pop_density", "type": "quantitative", "title": "People / km²", "format": ".2f"}
        ]
      }
    }
  ]
}
